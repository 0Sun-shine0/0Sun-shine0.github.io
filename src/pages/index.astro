---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, stats, techStack, techStackGroups, featured, projects, fmtDate } from '../data/site';

const mods = import.meta.glob('../posts/*.md', { eager: true }) as Record<string, any>;
const posts = Object.entries(mods)
  .map(([p, m]) => ({ slug: p.split('/').pop()!.replace(/\.md$/, ''), ...m.frontmatter }))
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
  .slice(0, 4);

// 首屏代码窗口：数据写盘时先保护旧文件（示意，实际在 pawpet/data_store.py）
const snippet = [
  '<span class="tk-com"># pawpet/data_store.py · 先保护旧数据</span>',
  '<span class="tk-key">def</span> <span class="tk-fn">save_data</span><span class="tk-punc">(</span>path<span class="tk-punc">,</span> data<span class="tk-punc">)</span> <span class="tk-punc">-&gt;</span> <span class="tk-key">None</span><span class="tk-punc">:</span>',
  '    temp <span class="tk-punc">=</span> path<span class="tk-punc">.</span>with_suffix<span class="tk-punc">(</span><span class="tk-str">\'.tmp\'</span><span class="tk-punc">)</span>',
  '    write_json<span class="tk-punc">(</span>temp<span class="tk-punc">,</span> data<span class="tk-punc">)</span>',
  '    flush_and_sync<span class="tk-punc">(</span>temp<span class="tk-punc">)</span>',
  '    replace<span class="tk-punc">(</span>temp<span class="tk-punc">,</span> path<span class="tk-punc">)</span>  <span class="tk-com"># 不直接覆盖原文件</span>',
].join('\n');

const total = featured.length + projects.length;
---
<BaseLayout>
  <!-- 首屏 -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <span class="pill">
          <span class="dot" aria-hidden="true"></span>{site.location} · {site.status}
        </span>

        <h1>
          {site.headline}<br />
          <span class="grad-text">{site.headlineAccent}</span>
        </h1>

        <!-- 求职向：一句话目标岗位，面试官第一眼要能看到 -->
        <p class="hero__job">
          <span class="job-tag">求职中</span>
          目标岗位：<b>{site.jobTarget}</b>
        </p>

        <p class="hero__sub">{site.intro}</p>

        <div class="job-card">
          <div class="job-card__text">
            <div class="job-card__title">求职意向</div>
            <div class="job-card__desc">{site.jobSummary}</div>
          </div>
          <a class="btn btn--primary btn--sm" href={site.resume} download>
            <Icon name="file" size={14} />下载简历 PDF
          </a>
        </div>

        <div class="btn-row">
            <a class="btn" href="/projects">看看我做过什么 <Icon name="arrow" cls="btn__icon" /></a>
            <a class="btn" href="/blog">看看最近在写什么</a>
          <button class="btn" type="button" data-copy={site.github}>
            <Icon name="github" size={15} />GitHub
          </button>
        </div>

        <div class="hero__stats">
          {stats.map((s) => (
            <div>
              <span class="stat__num">{s.num}</span>
              <span class="stat__label">{s.label}</span>
            </div>
          ))}
        </div>
        <!-- 数字是快照，标上日期，免得挂几个月后变成「半年前的最近」 -->
        <p class="mono faint" style="margin:0;font-size:.76rem">
          以上数字为 {site.metricsAsOf} 的快照；小爪助手仍在开发中
        </p>
      </div>

      <!-- 右侧：代码窗口 + 浮动数据卡 -->
      <div class="floats">
        <div class="codewin">
          <div class="codewin__bar">
            <span class="codewin__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="codewin__file">pawpet/data_store.py</span>
          </div>
          <pre><code set:html={snippet} /></pre>
        </div>

        <div class="float-card float-card--a">
          <span class="float-card__ico" aria-hidden="true">↓</span>
          <span>待办 / 番茄钟 <b>完全离线</b></span>
        </div>
        <div class="float-card float-card--b">
          <span class="float-card__ico" aria-hidden="true">◎</span>
          <span>安装包 <b>约 120MB</b>，双击即用</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 关键词跑马灯 -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {techStack.map((t) => <span>{t}</span>)}
    </div>
    <div class="marquee__track">
      {techStack.map((t) => <span>{t}</span>)}
    </div>
  </div>

  <!-- 技术栈（可读文字版） -->
  <!-- 上面那条跑马灯是 aria-hidden 的装饰；读屏和抓正文的工具都读不到它里面的词，
       所以这里再给一份正式的、能被读到和选中的清单。 -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="section__head" data-reveal>
        <span class="eyebrow">技术栈</span>
        <h2>我平时用什么</h2>
        <p class="lead">
          按用途分组，只列真的在项目里用过的。用到什么程度，「装备」页写了细节。
        </p>
      </div>

      <div class="techgrid" data-reveal>
        {techStackGroups.map((g) => (
          <div class="techgrid__group">
            <span class="techgrid__label">{g.label}</span>
            <div class="techgrid__items">
              {g.items.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        ))}
      </div>

      <div class="meta-row" style="margin-top:1.5rem">
        <a class="mono" href="/uses">看装备页的细节 <Icon name="arrow" size={14} /></a>
      </div>
    </div>
  </section>

  <!-- 主推作品 -->
  <section class="section">
    <div class="wrap">
      <div class="section__head section__head--row" data-reveal>
        <div class="stack gap-sm">
          <span class="eyebrow">主推作品</span>
          <h2>两个从零做到能用的项目</h2>
          <p class="lead">
            一个是我主导做的桌面工具，一个是把诗词拆成分镜、逐镜生成再拼起来的实验。
          </p>
        </div>
        <a class="btn btn--sm" href="/projects">全部 {total} 个项目 <Icon name="arrow" cls="btn__icon" /></a>
      </div>

      <div class="case-grid">
        {featured.map((p, i) => (
          <article class="card" data-reveal style={`--d:${i * 90}ms`}>
            <div class="card__top">
              <span class="card__idx">{p.idx} — {p.tags[0]}</span>
              <a class="card__link" href={`/projects#p${p.idx}`}>案例详情 <Icon name="arrow" cls="btn__icon" /></a>
            </div>
            <h3>{p.title}</h3>
            <p>{p.summary}</p>
            {p.shots ? (
              <figure class="shot" style="margin:1.1rem 0 0">
                <img src={p.shots[0].src} alt={p.shots[0].alt}
                     width={p.shots[0].w} height={p.shots[0].h}
                     loading="lazy" decoding="async" />
                <figcaption>{p.shots[0].caption}</figcaption>
              </figure>
            ) : null}
            <div class="case" style="margin-top:1.1rem">
              <div class="case__row">
                <span class="case__key">结果</span>
                <span class="case__val" set:html={p.result} />
              </div>
            </div>
            <div class="case__metric">
              {p.metrics.map((m) => <span class="tag tag--brand">{m}</span>)}
            </div>
          </article>
        ))}

        {projects.slice(0, 3).map((p, i) => (
          <article class="card" data-reveal style={`--d:${(i + 1) * 90}ms`}>
            <div class="card__top">
              <span class="card__idx">{p.idx} — {p.stack[0]}</span>
              <a class="card__link" href={`/projects#p${p.idx}`}>看看这个 <Icon name="arrow" cls="btn__icon" /></a>
            </div>
            <h3>{p.title}</h3>
            <p>{p.subtitle}</p>
            <div class="case__metric" style="margin-top:1.1rem">
              <span class="tag tag--brand">{p.stat}</span>
              {p.stack.slice(1).map((s) => <span class="tag">{s}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 最新笔记 -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="section__head section__head--row" data-reveal>
        <div class="stack gap-sm">
          <span class="eyebrow">最近的笔记</span>
          <h2>做东西时撞上的问题</h2>
        </div>
        <a class="btn btn--sm" href="/blog">全部笔记 <Icon name="arrow" cls="btn__icon" /></a>
      </div>

      <div class="list" data-reveal>
        {posts.map((post) => (
          <div class="list__item">
            <a class="list__link" href={`/blog/${post.slug}/`}>
              <span class="list__date">{fmtDate(post.date)}</span>
              <span>
                <span class="list__title">{post.title}</span>
                <span class="list__desc">{post.description}</span>
              </span>
              <span class="list__arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 结尾 CTA -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="cta" data-reveal>
        <h2>也在做桌面工具或者 Agent？</h2>
        <p>可以聊聊工具调用、权限分级、Windows 打包这些。写信或者加微信都行。</p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn--primary" href={site.github} target="_blank" rel="me noopener"><Icon name="github" size={16} />去 GitHub 找我</a>
          <a class="btn" href={`mailto:${site.email}`}><Icon name="mail" size={15} />写信：{site.email}</a>
          <button class="btn" type="button" data-copy={site.wechat}><Icon name="wechat" size={15} />微信 {site.wechat}</button>
          <button class="btn" type="button" data-copy={site.qq}><Icon name="chat" size={15} />QQ {site.qq}</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
